# ─── Église FOI SAINTE — Variables d'environnement ───────────────────────────
# Copiez ce fichier en ".env" et remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être commité sur Git (il est dans .gitignore).

# Clé secrète des sessions HTTP (obligatoire en production).
# Générez une valeur forte avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changez_cette_valeur_par_une_chaine_aleatoire_tres_longue

# Port du serveur (optionnel, défaut : 5500)
PORT=5500

# Mettre à "true" en production (active les cookies sécurisés HTTPS)
NODE_ENV=production

# Nombre de proxies devant le serveur (nginx = 1)
TRUST_PROXY=1
